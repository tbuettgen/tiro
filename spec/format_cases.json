{
  "defaults": {
    "cleanup": "light",
    "spoken_commands": true,
    "style": "formal",
    "corrections": [],
    "snippets": []
  },
  "cases": [
    { "name": "light collapses and trims", "input": "  hello   world  ", "expected": "Hello world." },
    { "name": "none returns collapsed verbatim", "input": "  hello   world  ", "options": { "cleanup": "none" }, "expected": "hello world" },
    { "name": "empty stays empty", "input": "   ", "expected": "" },
    { "name": "keeps existing terminal punctuation", "input": "really?", "expected": "Really?" },
    { "name": "semicolon end still gets a period", "input": "wait;", "expected": "Wait;." },
    { "name": "standalone i", "input": "i think i'm sure i'll go and i've been", "expected": "I think I'm sure I'll go and I've been." },
    { "name": "wifi untouched", "input": "the wifi is fine", "expected": "The wifi is fine." },
    { "name": "space before punctuation", "input": "hello , world .", "expected": "Hello, world." },
    { "name": "fillers stripped", "input": "um, so uh this is hmm good", "options": { "cleanup": "fillers" }, "expected": "So this is good." },
    { "name": "long fillers stripped", "input": "ummm well uhhh fine erm ok", "options": { "cleanup": "fillers" }, "expected": "Well fine ok." },
    { "name": "fillers kept in light mode", "input": "um, so this stays", "expected": "Um, so this stays." },
    { "name": "umbrella is not a filler", "input": "the column is umbrella-shaped", "options": { "cleanup": "fillers" }, "expected": "The column is umbrella-shaped." },
    { "name": "all-filler take is delivered as said", "input": "um uh hmm", "options": { "cleanup": "fillers" }, "expected": "um uh hmm" },
    { "name": "new line", "input": "first line new line second line", "expected": "First line\nSecond line." },
    { "name": "new paragraph keeps the comma before it", "input": "Dear team, new paragraph. Thanks for coming.", "expected": "Dear team,\n\nThanks for coming." },
    { "name": "new line keeps sentence period before it", "input": "Thanks. New line. Bob", "expected": "Thanks.\nBob." },
    { "name": "spoken comma and question mark", "input": "hello comma how are you question mark", "expected": "Hello, how are you?" },
    { "name": "spoken punctuation Whisper already punctuated", "input": "Hello, comma, how are you? Question mark.", "expected": "Hello, how are you?" },
    { "name": "spoken period", "input": "send it today period", "expected": "Send it today." },
    { "name": "spoken period after Whisper period", "input": "Okay. Period.", "expected": "Okay." },
    { "name": "period as an ordinary word", "input": "the trial period ends today", "expected": "The trial period ends today." },
    { "name": "exclamation and colon", "input": "note colon this is great exclamation point", "expected": "Note: this is great!" },
    { "name": "scratch that deletes its sentence", "input": "Let's meet at two. Actually let's do three scratch that. See you then.", "expected": "Let's meet at two. See you then." },
    { "name": "scratch that from the start", "input": "hello there scratch that goodbye", "expected": "Goodbye." },
    { "name": "scratch that alone is empty", "input": "Scratch that.", "expected": "" },
    { "name": "scratch that twice", "input": "One. Two scratch that. Three scratch that. Four.", "expected": "One. Four." },
    { "name": "scratch that respects a spoken period", "input": "one period two delete that", "expected": "One." },
    { "name": "scratch that stops at a new line", "input": "first item new line second item scratch that", "expected": "First item." },
    { "name": "fillers around a new line", "input": "um first item new line uh second item", "options": { "cleanup": "fillers" }, "expected": "First item\nSecond item." },
    { "name": "filler before a new line keeps the line break", "input": "first item um new line second", "options": { "cleanup": "fillers" }, "expected": "First item\nSecond." },
    { "name": "spoken commands off", "input": "hello comma world", "options": { "spoken_commands": false }, "expected": "Hello comma world." },
    { "name": "none mode ignores spoken commands", "input": "hello comma world", "options": { "cleanup": "none" }, "expected": "hello comma world" },
    { "name": "casual drops the final period", "input": "sounds good", "options": { "style": "casual" }, "expected": "Sounds good" },
    { "name": "casual keeps a question mark", "input": "are you coming?", "options": { "style": "casual" }, "expected": "Are you coming?" },
    { "name": "casual keeps an ellipsis", "input": "well...", "options": { "style": "casual" }, "expected": "Well..." },
    { "name": "very casual lowercases sentence starts", "input": "Hello there. I'm on my way. NASA called.", "options": { "style": "very_casual" }, "expected": "hello there. I'm on my way. NASA called" },
    { "name": "very casual across lines", "input": "Hey new line A quick note", "options": { "style": "very_casual" }, "expected": "hey\na quick note" },
    { "name": "corrections apply after cleanup", "input": "i use tyro daily", "options": { "corrections": [["tyro", "Tiro"]] }, "expected": "I use Tiro daily." },
    { "name": "corrections in none mode", "input": "tyro rocks", "options": { "cleanup": "none", "corrections": [["tyro", "Tiro"]] }, "expected": "Tiro rocks" },
    { "name": "corrections with symbols", "input": "i write c plus plus and dot net", "options": { "corrections": [["c plus plus", "C++"], ["dot net", ".NET"]] }, "expected": "I write C++ and .NET." },
    { "name": "corrections insert dollar signs literally", "input": "five bucks", "options": { "corrections": [["bucks", "$5"]] }, "expected": "Five $5." },
    { "name": "whole-take snippet", "input": "My email.", "options": { "snippets": [["my email", "trevor@example.com"]] }, "expected": "trevor@example.com" },
    { "name": "whole-take snippet ignores case and punctuation", "input": "  MY EMAIL!! ", "options": { "snippets": [["my email", "trevor@example.com"]] }, "expected": "trevor@example.com" },
    { "name": "multi-line snippet", "input": "sign off", "options": { "snippets": [["sign off", "Best,\nTrevor"]] }, "expected": "Best,\nTrevor" },
    { "name": "inline snippet", "input": "send it to my email please", "options": { "snippets": [["my email", "trevor@example.com"]] }, "expected": "Send it to trevor@example.com please." },
    { "name": "whole-take snippet beats none mode", "input": "my email", "options": { "cleanup": "none", "snippets": [["my email", "trevor@example.com"]] }, "expected": "trevor@example.com" },
    { "name": "url is not broken", "input": "go to example.com for details", "expected": "Go to example.com for details." },
    { "name": "decimal is not broken", "input": "pi is 3.14", "expected": "Pi is 3.14." }
  ]
}
